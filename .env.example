# Copy to .env and fill in values before running any tasks.
# .env is gitignored — never commit it.

# Everything below describes the Coder control plane you're pushing this
# template to — ask its platform team for these values.

# Coder's LoadBalancer is typically internal-only — reach it via a
# port-forward the control plane provides.
CODER_URL=http://localhost:8080

# Coder admin credentials. Only used by task workspace/task logs (coder
# create / log streaming — no Terraform equivalent exists for either).
CODER_ADMIN_EMAIL=admin@coder.demo
CODER_ADMIN_PASSWORD=

# Long-lived API token for the coderd Terraform provider (task template).
# Minted on the control plane — ask its platform team for one, or mint it
# yourself if you administer that control plane too.
CODER_API_TOKEN=

WORKSPACE_REPO=https://github.com/patelajk2319-coder/api-python

# Routes builds to a specific external provisioner (e.g. a team-owned
# cluster) instead of the control plane's built-in ones. Optional — leave
# blank to keep using the built-in provisioners.
PROVISIONER_TAG=

# Template governance metadata
TEMPLATE_OWNER=
TEMPLATE_COST_CENTRE=
TEMPLATE_TEAM=
TEMPLATE_ENV=

# Default autostop TTL for workspaces created from this template (e.g. 4h).
TEMPLATE_DEFAULT_TTL=4h

# Activity bump: extends the autostop deadline by this much on each detected
# session. Must be set explicitly — Coder defaults to 0 (off), which would
# stop an actively-used workspace right at TEMPLATE_DEFAULT_TTL.
TEMPLATE_ACTIVITY_BUMP=1h
