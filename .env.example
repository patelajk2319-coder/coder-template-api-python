# Copy to .env and fill in values before running any tasks.
# .env is gitignored — never commit it.

# Coder's LoadBalancer is internal-only (VPC-private) — reach it via the
# persistent port-forward coder-demo-eks's `task init` / `task port-forward` starts.
CODER_URL=http://localhost:8080

# Coder admin credentials — must match values set in coder-demo-eks/.env
CODER_ADMIN_EMAIL=admin@coder.demo
CODER_ADMIN_PASSWORD=

WORKSPACE_REPO=https://github.com/patelajk2319-coder/api-python

# GitHub fine-grained PAT scoped to the api-python repo — passed via Coder, never via pod spec
GITHUB_TOKEN=

# Template governance metadata
TEMPLATE_OWNER=
TEMPLATE_COST_CENTRE=
TEMPLATE_TEAM=
TEMPLATE_ENV=

# Default autostop TTL for workspaces created from this template (e.g. 4h).
TEMPLATE_DEFAULT_TTL=4h

# Activity bump: extends the autostop deadline by this much on each detected
# session. Must be set explicitly — Coder defaults to 0 (off), which would
# stop an actively-used workspace right at TEMPLATE_DEFAULT_TTL.
TEMPLATE_ACTIVITY_BUMP=1h
